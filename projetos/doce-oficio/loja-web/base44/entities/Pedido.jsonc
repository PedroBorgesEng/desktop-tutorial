{
  "name": "Pedido",
  "type": "object",
  "description": "Pedido de confeitaria. PagBank \u00e9 o checkout preferencial; pagamentos confirmados somente ap\u00f3s verifica\u00e7\u00e3o de assinatura e consulta \u00e0 API do provedor.",
  "properties": {
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo p\u00fablico de consulta do pedido (ex: DO-4F2A9C)"
    },
    "nome_cliente": {
      "type": "string",
      "description": "Nome de quem fez o pedido"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone com DDD para confirma\u00e7\u00e3o"
    },
    "email": {
      "type": "string",
      "description": "E-mail opcional do cliente"
    },
    "tipo_entrega": {
      "type": "string",
      "enum": [
        "retirada",
        "entrega"
      ],
      "enumColors": [
        "green",
        "blue"
      ],
      "description": "Retirada no ateli\u00ea ou entrega no endere\u00e7o informado"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o completo quando o tipo for entrega"
    },
    "data_desejada": {
      "type": "string",
      "format": "date",
      "description": "Data desejada para retirada ou entrega (AAAA-MM-DD)"
    },
    "periodo": {
      "type": "string",
      "enum": [
        "manha",
        "tarde"
      ],
      "enumColors": [
        "yellow",
        "purple"
      ],
      "description": "Per\u00edodo preferido"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do cliente"
    },
    "itens": {
      "type": "array",
      "description": "Itens pedidos, com pre\u00e7o congelado no momento do pedido",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "preco_unitario": {
            "type": "number"
          },
          "quantidade": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "description": "Soma dos itens, calculada no servidor"
    },
    "taxa_entrega": {
      "type": "number",
      "description": "Taxa fixa de entrega (0 na retirada)"
    },
    "total": {
      "type": "number",
      "description": "Total cobrado no checkout"
    },
    "status": {
      "type": "string",
      "enum": [
        "novo",
        "confirmado",
        "pronto",
        "entregue",
        "cancelado"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "purple",
        "green",
        "red"
      ],
      "default": "novo",
      "description": "Etapa do pedido no painel do ateli\u00ea"
    },
    "pagamento": {
      "type": "string",
      "enum": [
        "online",
        "a_combinar",
        "pix",
        "dinheiro",
        "debito",
        "credito"
      ],
      "enumColors": [
        "blue",
        "gray",
        "green",
        "yellow",
        "purple",
        "pink"
      ],
      "default": "online",
      "description": "Forma de pagamento do pedido"
    },
    "pagamento_status": {
      "type": "string",
      "enum": [
        "pendente",
        "pago",
        "cancelado"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "pendente",
      "description": "Situa\u00e7\u00e3o do pagamento confirmada pelo provedor"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Identificador da sess\u00e3o de checkout que gerou o pagamento"
    },
    "pagamento_gateway": {
      "type": "string",
      "enum": [
        "stripe",
        "mercadopago",
        "nenhum",
        "pagbank"
      ],
      "description": "Provedor do checkout utilizado"
    },
    "mercadopago_preference_id": {
      "type": "string",
      "description": "ID da prefer\u00eancia do Checkout Pro Mercado Pago"
    },
    "mercadopago_payment_id": {
      "type": "string",
      "description": "ID do pagamento confirmado pela API Mercado Pago"
    },
    "consulta_token": {
      "type": "string",
      "description": "Token aleat\u00f3rio de consulta por comprador (n\u00e3o \u00e9 senha)"
    },
    "pagbank_checkout_id": {
      "type": "string",
      "description": "Identificador do checkout hospedado PagBank (CHEC_...)"
    },
    "pagbank_order_id": {
      "type": "string",
      "description": "Identificador do pagamento PagBank (ORDE_...)"
    },
    "pagbank_env": {
      "type": "string",
      "enum": [
        "teste",
        "producao"
      ],
      "description": "Ambiente do provedor no momento da cria\u00e7\u00e3o do checkout"
    },
    "estoque_modelo": {
      "type": "string",
      "description": "Modelo de controle de disponibilidade da vers\u00e3o do pedido: ledger_v2 contabiliza pedidos ativos sem baixar estoque prematuramente."
    },
    "reserva_expira_em": {
      "type": "string",
      "description": "Hor\u00e1rio UTC ISO da expira\u00e7\u00e3o da reserva enquanto o checkout aguarda pagamento."
    }
  },
  "required": [
    "nome_cliente",
    "telefone",
    "tipo_entrega",
    "data_desejada",
    "itens",
    "total"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}